{
  "extends": "@preprocess/config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "resolvePackageJsonImports": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
