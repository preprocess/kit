{
  "name": "preprocess-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@preprocess/config": "workspace:*",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
